PORT=5000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/emailscheduler?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
WORKER_CONCURRENCY=5
MIN_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR=200

# Ethereal Email SMTP Credentials (if left empty, test account auto-generated on startup)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
